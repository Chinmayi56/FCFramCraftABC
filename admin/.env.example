# Local development: Vite's /api proxy (see vite.config.ts) forwards to
# http://127.0.0.1:8000, i.e. the same local FastAPI + MongoDB backend the
# Customer site's local dev server talks to. Keep this set to /api so Admin
# and Customer hit the *same* local backend/database during development —
# otherwise Admin falls back to the hardcoded production URL below (see
# src/lib/apiClient.ts) and any product created locally in Admin ends up in
# the production database instead of the one Customer is reading from.
VITE_API_BASE_URL=/api

# Production (e.g. Vercel): point at the deployed FastAPI backend. Its /api
# prefix is added automatically — do not include a trailing /api here.
# VITE_API_BASE_URL=https://fcframcraft.onrender.com
